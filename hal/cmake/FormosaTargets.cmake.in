# FORMOSA CMake SDK target definitions.
if(TARGET Formosa::formosa-hal.lv)
  return()
endif()

add_library(Formosa::libcomm INTERFACE IMPORTED)
set_target_properties(Formosa::libcomm PROPERTIES
  INTERFACE_INCLUDE_DIRECTORIES @FORMOSA_LIBCOMM_INCLUDE@
)

add_library(Formosa::falloc STATIC IMPORTED)
set_target_properties(Formosa::falloc PROPERTIES
  IMPORTED_LOCATION @FORMOSA_FALLOC@
  INTERFACE_INCLUDE_DIRECTORIES @FORMOSA_INCLUDE@
@FORMOSA_FALLOC_COVERAGE@
)

add_library(Formosa::formosa-real.lv STATIC IMPORTED)
set_target_properties(Formosa::formosa-real.lv PROPERTIES
  IMPORTED_LOCATION @FORMOSA_REAL@
@FORMOSA_REAL_COVERAGE@
  INTERFACE_LINK_LIBRARIES "$<LINK_ONLY:Formosa::falloc>;$<LINK_ONLY:Formosa::libcomm>"
)

add_library(Formosa::formosa-hal.lv STATIC IMPORTED)
set_target_properties(Formosa::formosa-hal.lv PROPERTIES
  IMPORTED_LOCATION @FORMOSA_HAL@
  INTERFACE_INCLUDE_DIRECTORIES @FORMOSA_INCLUDE@
@FORMOSA_HAL_COVERAGE@
  INTERFACE_LINK_LIBRARIES "$<LINK_ONLY:Formosa::formosa-real.lv>;$<LINK_ONLY:Formosa::falloc>"
)
