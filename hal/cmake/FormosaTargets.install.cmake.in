# FORMOSA CMake SDK target definitions.
if(TARGET Formosa::formosa-hal)
  return()
endif()

get_filename_component(_IMPORT_PREFIX "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
add_library(Formosa::libcomm INTERFACE IMPORTED)
set_target_properties(Formosa::libcomm PROPERTIES
  INTERFACE_INCLUDE_DIRECTORIES "${_IMPORT_PREFIX}/include"
)

add_library(Formosa::falloc STATIC IMPORTED)
set_target_properties(Formosa::falloc PROPERTIES
  IMPORTED_LOCATION "${_IMPORT_PREFIX}/lib/libfalloc.a"
  INTERFACE_INCLUDE_DIRECTORIES "${_IMPORT_PREFIX}/include"
@FORMOSA_FALLOC_COVERAGE@
)

# Every REAL backend; FORMOSA_REAL picks one at run time.
add_library(Formosa::formosa-real STATIC IMPORTED)
set_target_properties(Formosa::formosa-real PROPERTIES
  IMPORTED_LOCATION "${_IMPORT_PREFIX}/lib/libformosa-real.a"
@FORMOSA_REAL_COVERAGE@
  INTERFACE_LINK_LIBRARIES "$<LINK_ONLY:Formosa::falloc>;$<LINK_ONLY:Formosa::libcomm>"
)

add_library(Formosa::formosa-hal STATIC IMPORTED)
set_target_properties(Formosa::formosa-hal PROPERTIES
  IMPORTED_LOCATION "${_IMPORT_PREFIX}/lib/libformosa-hal.a"
  INTERFACE_INCLUDE_DIRECTORIES "${_IMPORT_PREFIX}/include"
@FORMOSA_HAL_COVERAGE@
  INTERFACE_LINK_LIBRARIES "$<LINK_ONLY:Formosa::formosa-real>;$<LINK_ONLY:Formosa::falloc>;@FORMOSA_CXX_RUNTIME@"
)

# The pinned PoCL links the HAL by the name it had when each HAL linked one
# backend. Remove the alias once it links Formosa::formosa-hal.
add_library(Formosa::formosa-hal.lv INTERFACE IMPORTED)
set_target_properties(Formosa::formosa-hal.lv PROPERTIES
  INTERFACE_LINK_LIBRARIES "Formosa::formosa-hal"
)
