use flake
source_env_if_exists ./.envrc.local

if [[ -n ${FORMOSA_LLVM_PREFIX:-} && -z ${FORMOSA_POCL_PREFIX:-} ]]; then
  log_error "FORMOSA_LLVM_PREFIX requires FORMOSA_POCL_PREFIX for OpenCL validation"
  return 1
fi

if [[ -n ${FORMOSA_POCL_PREFIX:-} ]]; then
  if [[ ! -d $FORMOSA_POCL_PREFIX ]]; then
    log_error "FORMOSA_POCL_PREFIX is not a directory: $FORMOSA_POCL_PREFIX"
    return 1
  fi
  export FORMOSA_POCL_PREFIX="$(realpath "$FORMOSA_POCL_PREFIX")"
  formosa_pocl_icd="$FORMOSA_POCL_PREFIX/etc/OpenCL/vendors/pocl.icd"
  if [[ ! -f $formosa_pocl_icd ]]; then
    log_error "local PoCL ICD does not exist: $formosa_pocl_icd"
    return 1
  fi

  IFS= read -r formosa_pocl_library < "$formosa_pocl_icd"
  if [[ $formosa_pocl_library != /* ]]; then
    for formosa_pocl_libdir in \
      "$FORMOSA_POCL_PREFIX/lib64" \
      "$FORMOSA_POCL_PREFIX/lib"; do
      if [[ -f $formosa_pocl_libdir/$formosa_pocl_library ]]; then
        formosa_pocl_library="$formosa_pocl_libdir/$formosa_pocl_library"
        break
      fi
    done
  fi
  if [[ ! -f $formosa_pocl_library ]]; then
    log_error "local PoCL library from $formosa_pocl_icd does not exist: $formosa_pocl_library"
    return 1
  fi
  formosa_pocl_library="$(realpath "$formosa_pocl_library")"
  if [[ $formosa_pocl_library != "$FORMOSA_POCL_PREFIX"/* ]]; then
    log_error "local PoCL library is outside FORMOSA_POCL_PREFIX: $formosa_pocl_library"
    return 1
  fi
  for formosa_pocl_libdir in \
    "$FORMOSA_POCL_PREFIX/lib" \
    "$FORMOSA_POCL_PREFIX/lib64"; do
    [[ -d $formosa_pocl_libdir ]] && path_add LD_LIBRARY_PATH "$formosa_pocl_libdir"
  done

  if ! formosa_pocl_dependencies="$(ldd "$formosa_pocl_library" 2>&1)"; then
    log_error "cannot inspect local PoCL dependencies: $formosa_pocl_library"
    return 1
  fi
  if [[ $formosa_pocl_dependencies == *"not found"* ]]; then
    log_error "local PoCL has unresolved dependencies:"
    log_error "$formosa_pocl_dependencies"
    return 1
  fi
  formosa_pocl_llvm_libraries="$(
    awk '$1 ~ /^libLLVM/ && $2 == "=>" { print $3 }' \
      <<< "$formosa_pocl_dependencies"
  )"
  if [[ -n $formosa_pocl_llvm_libraries ]]; then
    formosa_normalized_llvm_libraries=""
    while IFS= read -r formosa_llvm_library; do
      formosa_llvm_library="$(realpath "$formosa_llvm_library")"
      formosa_normalized_llvm_libraries+="$formosa_llvm_library"$'\n'
    done <<< "$formosa_pocl_llvm_libraries"
    formosa_pocl_llvm_libraries="${formosa_normalized_llvm_libraries%$'\n'}"
  fi

  if [[ -n ${FORMOSA_LLVM_PREFIX:-} ]]; then
    if [[ ! -d $FORMOSA_LLVM_PREFIX ]]; then
      log_error "FORMOSA_LLVM_PREFIX is not a directory: $FORMOSA_LLVM_PREFIX"
      return 1
    fi
    export FORMOSA_LLVM_PREFIX="$(realpath "$FORMOSA_LLVM_PREFIX")"
    if [[ ! -x $FORMOSA_LLVM_PREFIX/bin/llvm-config ]]; then
      log_error "local LLVM is missing bin/llvm-config: $FORMOSA_LLVM_PREFIX"
      return 1
    fi
    if [[ -z $formosa_pocl_llvm_libraries ]]; then
      log_error "local PoCL does not resolve LLVM libraries from $FORMOSA_LLVM_PREFIX"
      return 1
    fi
    while IFS= read -r formosa_llvm_library; do
      if [[ $formosa_llvm_library != "$FORMOSA_LLVM_PREFIX"/* ]]; then
        log_error "local PoCL does not resolve LLVM libraries from $FORMOSA_LLVM_PREFIX: $formosa_llvm_library"
        return 1
      fi
    done <<< "$formosa_pocl_llvm_libraries"
    PATH_add "$FORMOSA_LLVM_PREFIX/bin"
  fi

  export OCL_ICD_VENDORS="$formosa_pocl_icd"
  export POCL_DEVICES=formosa

  log_status "[WARNING] FORMOSA LOCAL OVERRIDE ACTIVE"
  log_status "  PoCL: $formosa_pocl_library"
  if [[ -n ${FORMOSA_LLVM_PREFIX:-} ]]; then
    log_status "  LLVM tools: $FORMOSA_LLVM_PREFIX/bin"
  fi
  if [[ -n $formosa_pocl_llvm_libraries ]]; then
    formosa_llvm_library="${formosa_pocl_llvm_libraries%%$'\n'*}"
    log_status "  PoCL LLVM libs: $(dirname "$formosa_llvm_library")"
  fi
fi

source_env_if_exists ./.lv-formosa-config.sh
