watch_file pytorch-dlprim/*.nix pytorch-dlprim/CMakeLists.txt pytorch-dlprim/ops.cc
watch_file formosa-mesa/*.nix
use flake || return 1
source_env_if_exists ./.envrc.local
source_env ./formosa-llvm/local-override.sh || return 1
source_env ./formosa-pocl/local-override.sh || return 1
source_env ./formosa-mesa/local-override.sh || return 1

# A local compiler must be checked against at least one installed local driver.
if [[ -n ${FORMOSA_LLVM_PREFIX:-} && -z ${FORMOSA_POCL_PREFIX:-} && -z ${FORMOSA_MESA_PREFIX:-} ]]; then
  log_error "FORMOSA_LLVM_PREFIX requires FORMOSA_POCL_PREFIX or FORMOSA_MESA_PREFIX for driver validation"
  return 1
fi
formosa_load_toolchain_overrides || return 1
formosa_load_pocl_overrides || return 1
formosa_load_mesa_overrides
